# Garder en cache les images et polices pendant 1 an (très efficace)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Le CSS et le JS : cache d'une semaine (pour qu'ils voient vos mises à jour de design)
/styles.css
  Cache-Control: public, max-age=604800, must-revalidate
/script.js
  Cache-Control: public, max-age=604800, must-revalidate

# Le HTML et les JSON : cache très court (0s) pour voir les nouveaux textes immédiatement
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/content/*.json
  Cache-Control: public, max-age=0, must-revalidate
